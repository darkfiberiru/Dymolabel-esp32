#ifndef CONFIG_H
#define CONFIG_H

// WiFi Provisioning Configuration
// Credentials are stored in NVS (Non-Volatile Storage) via BLE provisioning
// Use the "ESP BLE Provisioning" app to configure WiFi

// Device name shown during BLE provisioning
#define WIFI_PROV_DEVICE_NAME "Dymolabel-ESP32"

// Proof of Possession (PoP) for secure provisioning
// Comment out WIFI_PROV_USE_POP to disable (less secure, easier setup)
#define WIFI_PROV_USE_POP
#define WIFI_PROV_POP "dymolabel123"

// Uncomment to reset WiFi provisioning on every boot (for testing only)
// WARNING: This will erase stored WiFi credentials on each reboot
// #define WIFI_PROV_RESET_ON_BOOT

// Hostname for mDNS
#define HOSTNAME "dymolabel"

// Web Server Port
#define WEB_SERVER_PORT 80

// Printer Configuration
#define DYMO_LABEL_WIDTH 64  // Label width in pixels (12mm tape = 64px)
#define DYMO_MAX_LENGTH 1024 // Maximum label length in pixels

// Debug
#define DEBUG_SERIAL true

#endif
